{
  "schema_version": 2,
  "domain": "unit",
  "coverage": {
    "branch": true,
    "floor": 78,
    "source": "src/gpu_fault",
    "deployment_only_globs": [
      "src/gpu_fault/admin_*.py"
    ],
    "application_shared_files": [
      "src/gpu_fault/admin_config.py",
      "src/gpu_fault/admin_config_parser.py",
      "src/gpu_fault/admin_site.py"
    ]
  },
  "tests": {
    "coverage_excluded_files": [
      "tests/regional/test_complete_acceptance_entries.py",
      "tests/regional/test_regional_acceptance_fixtures.py",
      "tests/regional/test_regional_acceptance_spec.py",
      "tests/regional/test_regional_case_index.py",
      "tests/test_change_impact.py",
      "tests/test_ci_gate.py",
      "tests/test_ci_unit_gate.py",
      "tests/test_deployment_manual_contracts.py",
      "tests/test_doc_impact.py",
      "tests/test_documentation_contracts.py",
      "tests/test_env_reference.py",
      "tests/test_fault_evidence.py",
      "tests/test_fault_scenario_catalog.py",
      "tests/test_operations_manual_guide.py",
      "tests/test_script_assets.py"
    ],
    "postgres_files": [
      "tests/store/test_postgres_store.py",
      "tests/store/test_postgres_processor_claim.py",
      "tests/store/test_postgres_reconnect.py",
      "tests/store/test_store_contracts.py"
    ],
    "fault_runner_files": [
      "tests/test_case_scheduler.py"
    ],
    "deployment_prefixes": [
      "tests/admin/",
      "tests/regional/"
    ],
    "deployment_globs": [
      "tests/test_*artifact*.py",
      "tests/test_*builder*.py",
      "tests/test_component_artifacts.py",
      "tests/test_deploy_*.py",
      "tests/test_public_release.py",
      "tests/test_release_*.py",
      "tests/test_staging_deploy.py"
    ],
    "shared_files": [
      "tests/__init__.py",
      "tests/_builders.py",
      "tests/_script_loader.py",
      "tests/conftest.py"
    ]
  },
  "identity": {
    "exclude_prefixes": [
      ".github/",
      "docs/"
    ],
    "exclude_globs": [
      "**/README.md",
      "scripts/**/README.md",
      "scripts/audit-*.py",
      "scripts/check-*.py"
    ],
    "exclude_files": [
      ".yamllint",
      "AGENTS.md",
      "architecture-baseline.json",
      "assert-message-baseline.json",
      "CONTRIBUTING.md",
      "README.md",
      "mypy-baseline.json",
      "scripts/README.md",
      "scripts/ci_gate.py",
      "scripts/prune_artifacts.py",
      "scripts/resolve_ci_run.py"
    ],
    "protocol_files": [
      "Makefile",
      "config/ci-unit-gate.json",
      "scripts/ci_coverage_gate.py",
      "scripts/ci_unit_gate.py",
      "tools/pytest_case_reporter.py",
      "tools/pytest_result_identity.py"
    ]
  },
  "protocol": {
    "postgres_image": "postgres:16",
    "postgres_stress_rounds": 40,
    "postgres_stress_workers": 8,
    "pytest_dist": "worksteal",
    "pytest_durations": 50,
    "pytest_workers": 4,
    "runtime_partitions": 3
  },
  "shards": {
    "runtime_0": {
      "identity_groups": [
        "dependencies",
        "protocol",
        "runtime_source",
        "runtime_tests",
        "shared_tests"
      ],
      "omit_deployment_source": true
    },
    "runtime_1": {
      "identity_groups": [
        "dependencies",
        "protocol",
        "runtime_source",
        "runtime_tests",
        "shared_tests"
      ],
      "omit_deployment_source": true
    },
    "runtime_2": {
      "identity_groups": [
        "dependencies",
        "protocol",
        "runtime_source",
        "runtime_tests",
        "shared_tests"
      ],
      "omit_deployment_source": true
    },
    "deployment": {
      "identity_groups": [
        "dependencies",
        "protocol",
        "runtime_source",
        "deployment_source",
        "deployment_tests",
        "shared_tests"
      ],
      "omit_deployment_source": false
    },
    "fault_runner": {
      "identity_groups": [
        "dependencies",
        "protocol",
        "runtime_source",
        "fault_runner_source",
        "fault_runner_tests",
        "shared_tests"
      ],
      "omit_deployment_source": true
    },
    "postgres": {
      "identity_groups": [
        "dependencies",
        "protocol",
        "runtime_source",
        "postgres_tests",
        "shared_tests"
      ],
      "omit_deployment_source": true
    }
  }
}
