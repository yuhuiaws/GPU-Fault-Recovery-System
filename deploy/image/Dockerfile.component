ARG RUNTIME_BASE_IMAGE=registry.access.redhat.com/ubi9/python-312-minimal@sha256:ddf83888de3388bce2fc9c3d66f917bf683790d4db9f956644a3e1b9b6fd15e7
FROM ${RUNTIME_BASE_IMAGE}

USER 0
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements/runtime.lock /tmp/gpu-fault-runtime.lock
RUN python -m venv /opt/gpu-fault/runtime \
    && /opt/gpu-fault/runtime/bin/python -m pip install \
      --no-cache-dir --require-hashes -r /tmp/gpu-fault-runtime.lock \
    && /opt/gpu-fault/runtime/bin/python -m pip check \
    && rm -f /tmp/gpu-fault-runtime.lock
ENV VIRTUAL_ENV=/opt/gpu-fault/runtime \
    PATH="/opt/gpu-fault/runtime/bin:${PATH}"

# Keep the dependency layer identical across the two component images.
ARG COMPONENT
ARG DISTRIBUTION
COPY wheels /tmp/gpu-fault-wheels
RUN case "${COMPONENT}:${DISTRIBUTION}" in \
      control-plane:gpu-fault-control-plane|executor:gpu-fault-cluster-executor) ;; \
      *) exit 1 ;; \
    esac \
    && ln -s runtime "/opt/gpu-fault/${COMPONENT}" \
    && python -m pip install \
      --no-cache-dir --no-deps /tmp/gpu-fault-wheels/*.whl \
    && python -m pip check \
    && python -I -c \
      'import importlib.metadata as m, sys, pydantic; assert set(m.packages_distributions()["gpu_fault"]) == {sys.argv[1]}' \
      "${DISTRIBUTION}" \
    && rm -rf /tmp/gpu-fault-wheels

USER 1001
ENTRYPOINT []
