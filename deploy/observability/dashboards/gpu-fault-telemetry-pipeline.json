      "panels": [],
      "title": "Remote write",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "Alert GpuFaultTelemetryRemoteWriteFailing (critical, for 10m, > 0): docs/管理员日常运维.md#gpufaulttelemetryremotewritefailing",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.0
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "sum by (control_plane_cluster, region) (rate(otelcol_exporter_send_failed_metric_points{control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"}[5m]))",
          "instant": false,
          "legendFormat": "{{control_plane_cluster}} {{region}} failed/s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "sum by (control_plane_cluster, region) (rate(otelcol_exporter_sent_metric_points{control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"}[5m]))",
          "instant": false,
          "legendFormat": "{{control_plane_cluster}} {{region}} sent/s",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Remote-write failed points",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "Alert GpuFaultTelemetryRemoteWriteQueueSaturated (warning, for 10m, > 0.8): docs/管理员日常运维.md#gpufaulttelemetryremotewritequeuesaturated",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "max by (control_plane_cluster, region) (otelcol_exporter_queue_size{control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"} / otelcol_exporter_queue_capacity{control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"})",
          "instant": false,
          "legendFormat": "{{control_plane_cluster}} {{region}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Remote-write queue fill",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "Collector resident memory against its 256Mi limit (GOMEMLIMIT 220MiB); an OOMKill loop still lands a batch per restart, so absence alerts stay quiet (H2-4).\n\nAlert GpuFaultAdotMemoryHigh (warning, for 10m, > 2.09715e+08): docs/管理员日常运维.md#gpufaultadotmemoryhigh",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 209715200.0
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "max by (control_plane_cluster, region) (otelcol_process_memory_rss{control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"})",
          "instant": false,
          "legendFormat": "{{control_plane_cluster}} {{region}} rss",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Collector memory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
