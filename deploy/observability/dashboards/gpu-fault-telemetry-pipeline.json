      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "max by (control_plane_cluster, region, gpu_cluster) (up{job=\"gpu-fault-dataplane\",control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"})",
          "instant": true,
          "legendFormat": "{{gpu_cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Data-plane scrape up by GPU cluster",
      "type": "stat"
