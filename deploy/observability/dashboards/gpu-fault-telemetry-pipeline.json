          "expr": "sum by (control_plane_cluster, region, gpu_cluster) (increase(gpu_fault_completion_outbox_append_failures_total{control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"}[10m]))",
          "instant": false,
          "legendFormat": "{{gpu_cluster}}",
          "range": true,
