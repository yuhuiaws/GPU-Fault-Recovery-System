      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "0 or absent: the collector's own pipeline counters are not reaching AMP, so the two panels above are blind.\n\nAlert GpuFaultAdotSelfMetricsMissing (critical, for 10m): docs/管理员日常运维.md#gpufaultadotselfmetricsmissing",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 6,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "up{job=\"gpu-fault-adot-self\",control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"}",
          "instant": true,
          "legendFormat": "{{control_plane_cluster}} {{region}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "ADOT self-telemetry up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "1 per GPU cluster whose ADOT collector (adot-dataplane.yaml) scrapes at least one data-plane target. 0 or a missing cluster: the Completion Watcher row below is blind for it. A cluster whose release skipped the collector (no adot_irsa_role_arn) never appears here.\n\nAlert GpuFaultDataplaneCollectorMissing (warning, for 15m): docs/管理员日常运维.md#gpufaultdataplanecollectormissing",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
