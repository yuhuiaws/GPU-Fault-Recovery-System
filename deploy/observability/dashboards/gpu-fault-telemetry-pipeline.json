    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "Each step is a critical completion event that was delivered without a write-ahead copy, so only a watcher restart turns it into a lost or replayed event.\n\nAlert GpuFaultCompletionOutboxAppendFailures (warning, for 15m, > 0): docs/管理员日常运维.md#gpufaultcompletionoutboxappendfailures",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
