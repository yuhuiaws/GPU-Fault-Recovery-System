    {
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-fault-amp"
      },
      "description": "A PENDING command no cluster executor has claimed; the recovery it carries is silently not happening.\n\nAlert GpuFaultRemoteCommandUnclaimed (critical, for 2m, > 600): docs/管理员日常运维.md#gpufaultremotecommandunclaimed",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600.0
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gpu-fault-amp"
          },
          "expr": "max by (cluster_id) (gpu_fault_remote_command_oldest_unclaimed_seconds{cluster_id=~\"$cluster_id\",control_plane_cluster=~\"$control_plane_cluster\",region=~\"$region\"})",
          "instant": false,
          "legendFormat": "{{cluster_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Oldest unclaimed remote command",
      "type": "timeseries"
    },
