{
  "aws_region": "REPLACE_WITH_AWS_REGION",
  "cpu_kubeconfig": "/secure/cpu-control-plane.kubeconfig",
  "cpu_eks_arn": "REPLACE_WITH_CPU_EKS_ARN",
  "cpu_hyperpod_cluster_name": "REPLACE_WITH_CPU_HYPERPOD_CLUSTER_NAME",
  "namespace": "gpu-fault-system",
  "auto_rollback": true,
  "runtime_profile": {
    "source": "REPLACE_WITH_RUNTIME_PROFILE_PATH",
    "version": "hyperpod-v1",
    "registration_cluster_id": "gpu-prod-a"
  },
  "release": {
    "manifest": "../../../dist/current-release.json",
    "agent_config_digest": "REPLACE_WITH_64_HEX_CONFIG_DIGEST"
  },
  "nlb": {
    "name": "REPLACE_WITH_NLB_NAME",
    "public_subnets": "REPLACE_WITH_PUBLIC_SUBNET_IDS",
    "security_group": "REPLACE_WITH_NLB_SECURITY_GROUP_ID",
    "certificate_arn": "REPLACE_WITH_ACM_CERTIFICATE_ARN"
  },
  "dns": {
    "hosted_zone_id": "REPLACE_WITH_ROUTE53_HOSTED_ZONE_ID",
    "hostname": "REPLACE_WITH_CONTROL_PLANE_HOSTNAME"
  },
  "health": {
    "aurora_cluster_id": "gpu-fault-regional-aurora",
    "amp_workspace_id": "REPLACE_WITH_AMP_WORKSPACE_ID",
    "amp_rule_namespace": "gpu-fault-control-plane-capacity",
    "sns_topic_arn": "REPLACE_WITH_SNS_TOPIC_ARN",
    "certificate_min_validity_days": 30,
    "remote_command_max_unclaimed_seconds": 300,
    "require_confirmed_sns_subscription": true
  },
  "notifications": {
    "allow_email": true,
    "acknowledge_external_alert_channel": false
  },
  "clusters": [
    {
      "cluster_id": "gpu-prod-a",
      "context": "REPLACE_WITH_GPU_EKS_CONTEXT",
      "region": "REPLACE_WITH_AWS_REGION",
      "hyperpod_cluster_name": "REPLACE_WITH_GPU_HYPERPOD_CLUSTER_NAME",
      "eks_cluster_arn": "REPLACE_WITH_GPU_EKS_ARN",
      "executor_irsa_role_arn": "REPLACE_WITH_EXECUTOR_IRSA_ROLE_ARN",
      "allowed_namespaces": [
        "gpu-fault-system",
        "training"
      ],
      "control_plane_url": "https://regional-control-plane.example",
      "token_file": "/secure/gpu-prod-a.token",
      "ca_file": "/secure/control-plane-ca.crt",
      "fleet_master_file": "/secure/fleet-master"
    }
  ]
}
