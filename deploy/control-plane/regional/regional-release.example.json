{
  "cpu_kubeconfig": "/secure/cpu-control-plane.kubeconfig",
  "namespace": "gpu-fault-system",
  "auto_rollback": true,
  "release": {
    "manifest": "../../../dist/current-release.json",
    "agent_config_digest": "REPLACE_WITH_64_HEX_CONFIG_DIGEST"
  },
  "nlb": {
    "public_subnets": "subnet-a,subnet-b",
    "security_group": "sg-0123456789abcdef0",
