      "region": "us-west-2",
      "hyperpod_cluster_name": "gpu-prod-a",
      "eks_cluster_arn": "arn:aws:eks:us-west-2:123456789012:cluster/gpu-prod-a",
      "executor_irsa_role_arn": "arn:aws:iam::123456789012:role/gpu-fault-executor",
      "allowed_namespaces": [
        "gpu-fault-system",
        "training"
      ],
      "control_plane_url": "https://regional-control-plane.example",
      "token_file": "/secure/gpu-prod-a.token",
      "ca_file": "/secure/control-plane-ca.crt",
      "fleet_master_file": "/secure/fleet-master"
    }
  ]
