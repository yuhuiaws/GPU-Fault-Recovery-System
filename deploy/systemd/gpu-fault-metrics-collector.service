[Unit]
Description=GPU hardware metrics collector
# Ordered after the driver's persistence daemon as well: a collector that
# starts before the driver answers discovers no GPU product and stamps
# product=None on what it posts until its late re-discovery succeeds.
# And after Fabric Manager, ordering only (never Requires=/Wants=: a node
# without NVSwitches has no such unit, and a failed Fabric Manager must not
# keep the collector down): the fabric_manager_status window counts from the
# collector's first observation (gpu_fault/gpu_fabric_manager.py), so at boot
# the collector starts once Fabric Manager's start job has finished -- on NVL5
# (HGX B200/B300) once the unit has started NVLSM and Fabric Manager.
After=network-online.target nvidia-persistenced.service nvidia-fabricmanager.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-fault/collector.env
ExecStart=/opt/gpu-fault/current/venv/bin/gpu-fault-collector ${GPU_FAULT_METRICS_MODE}
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gpu-fault
# Resource control
CPUWeight=20
CPUQuota=100%
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
IOWeight=20

[Install]
WantedBy=multi-user.target
