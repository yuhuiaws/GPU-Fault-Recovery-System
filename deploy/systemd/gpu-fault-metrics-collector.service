[Unit]
Description=GPU hardware metrics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-fault/collector.env
ExecStart=/opt/gpu-fault/venv/bin/gpu-fault-collector ${GPU_FAULT_METRICS_MODE}
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gpu-fault
# Resource control
CPUWeight=20
CPUQuota=100%
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
IOWeight=20

[Install]
WantedBy=multi-user.target
