[Unit]
Description=GPU fault signed node action agent
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-fault/node-agent.env
ExecStart=/opt/gpu-fault/current/venv/bin/gpu-fault-node-agent
Restart=always
RestartSec=5
# The agent writes one structured INFO line per command accept/start/
# completion (command_id, incident_id, operation, attempt, status, duration).
# Keep them in the journal, unfiltered, under a stable identifier:
#   journalctl -t gpu-fault-node-agent -g 'command_id='
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpu-fault-node-agent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gpu-fault
# Resource control: keep the agent from ever competing with the
# training job for memory or CPU on a 192 vCPU / 2 TiB node.
CPUWeight=20
CPUQuota=200%
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
TasksMax=512
IOWeight=20

[Install]
WantedBy=multi-user.target
