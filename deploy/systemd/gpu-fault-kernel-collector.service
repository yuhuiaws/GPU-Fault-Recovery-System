[Unit]
Description=GPU fault kernel XID/SXID collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-fault/collector.env
ExecStart=/opt/gpu-fault/current/venv/bin/gpu-fault-collector kernel
Restart=always
RestartSec=5
# On SIGTERM the collector drains its pending queue to the outbox, and the
# drain's upper bound is a sum, not a guess (kernel.py,
# DELIVERY_DRAIN_BUDGET_SECONDS): the reader notices the stop within its
# 1 s select timeout (+1 s reopen sleep), the delivery thread gets a 5 s join,
# the drain itself has a 5 s budget checked between records, and the record
# in flight when the budget runs out costs at most ONE single-attempt post
# (HttpEventSink.deliver_once, bounded by GPU_FAULT_COLLECTOR_HTTP_TIMEOUT_SECONDS
# = 10 s by default; never the retry ladder). 2 + 5 + 5 + 10 = 22 s; 30 s
# leaves the margin. Records the drain cannot reach are counted and named in an
# ERROR line before exit -- a SIGKILL here is what would silence that line, so
# raising GPU_FAULT_COLLECTOR_HTTP_TIMEOUT_SECONDS means raising this too.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/dev/kmsg /proc/sys/kernel/random/boot_id
# ProtectSystem=strict makes /var read-only, and the collector CLI
# defaults GPU_FAULT_COLLECTOR_OUTBOX_PATH to
# /var/lib/gpu-fault/outbox/kernel.ndjson. Without this the outbox write
# fails with EROFS and every XID/SXID that could not be delivered is
# dropped -- which is exactly the case the outbox exists for.
StateDirectory=gpu-fault
# Resource control
CPUWeight=20
CPUQuota=50%
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
TasksMax=128
IOWeight=20

[Install]
WantedBy=multi-user.target
