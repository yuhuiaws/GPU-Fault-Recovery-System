[Unit]
Description=GPU fault NVIDIA Fabric Manager SXID collector
After=network-online.target systemd-journald.service nvidia-fabricmanager.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-fault/collector.env
ExecStart=/opt/gpu-fault/venv/bin/gpu-fault-collector fabric-manager
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StateDirectory=gpu-fault
SupplementaryGroups=systemd-journal
# Resource control
CPUWeight=20
CPUQuota=50%
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
TasksMax=128
IOWeight=20

[Install]
WantedBy=multi-user.target
